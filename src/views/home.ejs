<%- include('partials_header', { title: 'Job Openings' }) %>

<h1>Latest Job Openings</h1>
<p class="subtitle">Blog-style listing of approved job postings.</p>

<section class="jobs-grid">
  <% if (jobs.length === 0) { %>
    <article class="job-card"><p>No published jobs yet.</p></article>
  <% } %>

  <% jobs.forEach((job) => { %>
    <article class="job-card">
      <h2><%= job.title %></h2>
      <p><strong>ID:</strong> <%= job.id %></p>
      <p><strong>Posting date:</strong> <%= job.posting_date %></p>
      <p><strong>Company:</strong> <%= job.company %></p>
      <p><strong>City:</strong> <%= job.city %></p>
      <p><strong>Address:</strong> <%= job.address %></p>
      <p><strong>Contact:</strong> <%= job.contact %></p>
      <p><strong>Contract type:</strong> <%= job.contract_type %></p>
      <p><strong>Salary:</strong> <%= job.optional_salary || 'Not provided' %></p>
      <p><strong>Posting duration:</strong> <%= job.posting_duration %> days</p>
    </article>
  <% }) %>
</section>

<div class="pagination">
  <% if (page > 1) { %>
    <a href="/?page=<%= page - 1 %>">Previous</a>
  <% } %>
  <span>Page <%= page %> of <%= totalPages %></span>
  <% if (page < totalPages) { %>
    <a href="/?page=<%= page + 1 %>">Next</a>
  <% } %>
</div>

<%- include('partials_footer') %>
